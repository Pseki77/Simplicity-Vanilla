{
  "name": "simplicity-vanilla",
  "productName": "Simplicity Vanilla",
  "version": "1.0.0",
  "description": "A client for deadshot.io. known for its simplicity, i guess bro....",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . SimplicityVanilla --platform=win32 --arch=x64 --out=dist --overwrite --no-asar --ignore=/swap && node -e \"require('fs').cpSync('swap','dist/SimplicityVanilla-win32-x64/swap',{recursive:true})\"",
    "package": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.3"
  }
}
